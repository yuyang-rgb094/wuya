# =============================================================================
# WuYa Agents — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Environment variables take precedence over .env file values.
# All variables are optional — sensible defaults are provided.
# =============================================================================

# --- Application ---
WUYA_ENVIRONMENT=development          # development | testing | production
WUYA_DEBUG=false                      # Enable debug mode (verbose logging)
WUYA_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# --- LLM Configuration ---
WUYA_LLM_PROVIDER=openai              # openai | anthropic
OPENAI_API_KEY=                       # Your OpenAI API key
ANTHROPIC_API_KEY=                    # Your Anthropic API key
WUYA_LLM_OPENAI_MODEL=gpt-4o          # OpenAI model name
WUYA_LLM_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022  # Anthropic model name
WUYA_LLM_TEMPERATURE=0.1              # Sampling temperature (0.0 - 2.0)
WUYA_LLM_MAX_TOKENS=2000              # Max response tokens
WUYA_LLM_REQUEST_TIMEOUT=120          # Request timeout in seconds
WUYA_LLM_API_BASE_URL=                # Custom API base URL (optional)
WUYA_LLM_MAX_RETRIES=3                # Max retry attempts
WUYA_LLM_RATE_LIMIT_RPM=100           # Requests per minute limit
WUYA_LLM_RATE_LIMIT_TPM=100000        # Tokens per minute limit

# --- RAG Configuration ---
WUYA_RAG_ENABLED=true                 # Enable RAG retrieval
WUYA_RAG_VECTOR_STORE_TYPE=in_memory  # in_memory | chromadb
WUYA_RAG_CHROMADB_HOST=localhost      # ChromaDB host
WUYA_RAG_CHROMADB_PORT=8000           # ChromaDB port
WUYA_RAG_CHROMADB_COLLECTION=wuya_papers  # ChromaDB collection name
WUYA_RAG_EMBEDDING_PROVIDER=mock      # mock | openai
WUYA_RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
WUYA_RAG_TOP_K=5                      # Number of documents to retrieve
WUYA_RAG_SIMILARITY_THRESHOLD=0.7     # Minimum similarity score (0.0 - 1.0)
WUYA_RAG_CACHE_ENABLED=true           # Cache embedding results

# --- Evaluation Configuration ---
WUYA_EVAL_CUDOS_THRESHOLD=3.0         # CUDOS gate threshold (0.0 - 5.0)
WUYA_EVAL_DEA_ENABLED=true            # Enable DEA analysis
WUYA_EVAL_DEA_MIN_REFERENCES=50       # Min reference papers for DEA
WUYA_EVAL_FRONTIER_ENABLED=true       # Enable frontier discovery
WUYA_EVAL_PARALLEL_EVALUATION=true    # Run sub-agents in parallel
WUYA_EVAL_MAX_CONCURRENT_AGENTS=4     # Max concurrent evaluations

# --- Server Configuration (for `wuya serve`) ---
WUYA_SERVER_HOST=0.0.0.0             # Server bind host
WUYA_SERVER_PORT=8000                 # Server bind port
WUYA_SERVER_WORKERS=1                 # Number of worker processes
WUYA_SERVER_API_PREFIX=/api/v1        # API URL prefix
